{$SITE_DOMAIN} {
    encode gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
    handle /api/* {
        reverse_proxy api:8000 {
            transport http {
                response_header_timeout 300s
            }
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
