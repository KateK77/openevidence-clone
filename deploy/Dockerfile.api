FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt /app/backend-requirements.txt
COPY deploy/requirements.txt /app/deploy-requirements.txt
RUN pip install --no-cache-dir -r backend-requirements.txt -r deploy-requirements.txt
COPY backend /app/backend
RUN useradd --create-home researcher
USER researcher
WORKDIR /app/backend
CMD ["gunicorn", "evidence.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--threads", "4", "--timeout", "300", "--access-logfile", "-"]
